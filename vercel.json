{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*admin.*"
        }
      ],
      "destination": "/ADMIN_PANEL/$1"
    },
    {
      "source": "/LISTING_INTERN/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*frontend.*"
        }
      ],
      "destination": "/LISTING_INTERN/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*frontend.*"
        }
      ],
      "destination": "/FRONTEND/$1"
    }
  ]
}
